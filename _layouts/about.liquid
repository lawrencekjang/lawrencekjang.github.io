---
layout: default
---
<section class="intro" aria-labelledby="intro-title">
  <div class="intro-copy">
    <p class="intro-eyebrow">Machine Learning at Carnegie Mellon</p>
    <h1 id="intro-title">
      Lawrence<br>
      Jang<span class="name-dot">.</span>
    </h1>
    <div class="intro-bio">{{ content }}</div>
    <nav class="contact-links" aria-label="Connect with Lawrence">
      <a href="mailto:ljang@cs.cmu.edu">Email</a>
      <a href="https://scholar.google.com/citations?user=HqC4vl8AAAAJ">Google Scholar</a>
      <a href="https://x.com/JangLawrenceK">Twitter</a>
      <a href="https://github.com/ljang0">GitHub</a>
    </nav>
  </div>
  <div class="portrait-wrap">
    <svg class="portrait-spark" viewBox="0 0 100 100" aria-hidden="true">
      <path d="M50 5 57 35 80 15 67 42 98 45 69 56 88 81 60 68 53 98 44 69 17 86 31 59 3 51 34 43 15 19 42 34Z" fill="currentColor"/>
    </svg>
    <figure class="portrait">
      <img
        src="{{ page.profile.image | prepend: '/assets/img/' | relative_url }}"
        width="399"
        height="399"
        alt="Lawrence Jang smiling at a restaurant"
        fetchpriority="high"
      >
    </figure>
    <span class="portrait-note" aria-hidden="true">hello, world!</span>
  </div>
</section>

<section class="research-section" id="research" aria-labelledby="research-title">
  <div class="research-heading">
    <div>
      <p class="section-eyebrow">Papers & projects</p>
      <h2 id="research-title">Selected research<span class="name-dot">.</span></h2>
    </div>
    <a class="all-publications" href="{{ '/publications/' | relative_url }}">All publications</a>
  </div>
  <div class="research-toolbar" hidden>
    <div class="year-filters" role="group" aria-label="Filter research by year">
      <button type="button" data-year-filter="all" aria-pressed="true">All years</button>
      <button type="button" data-year-filter="2026" aria-pressed="false">2026</button>
      <button type="button" data-year-filter="2025" aria-pressed="false">2025</button>
      <button type="button" data-year-filter="2024" aria-pressed="false">2024</button>
    </div>
    <p class="paper-count" aria-live="polite"></p>
  </div>
  {% include selected_papers.liquid %}
</section>
